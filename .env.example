# Copy this file to .env and fill in your values. .env is ignored by git.

# Discord webhook for alerts. Leave empty to only show alerts in the app.
DISCORD_WEBHOOK_URL=

# Only alerts at or above this severity are sent to Discord: LOW, MEDIUM, HIGH or CRITICAL.
DISCORD_MIN_SEVERITY=HIGH

# Who can connect. 127.0.0.1 = this PC only. 0.0.0.0 = agents on other machines may send events
# (only to /api/v1/ingest; the console stays on this PC). 0.0.0.0 needs SENTINELA_INGEST_KEY.
SENTINELA_HOST=127.0.0.1

# Secret that every agent must send. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINELA_INGEST_KEY=
